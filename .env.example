# JIRA Cloud connection (required)
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
# Must be a CLASSIC, UNSCOPED API token (basic auth). A scoped token — one
# created with granular scopes like read:jira-work / write:jira-work — is
# REJECTED by basic auth: JIRA then serves requests anonymously and every
# search comes back empty. Create an unscoped token here:
#   https://id.atlassian.com/manage-profile/security/api-tokens  → "Create API token"
JIRA_API_TOKEN=your-api-token

# Optional (used by later tool slices)
# JIRA_PROJECT_DEFAULT=PROJ
# JIRA_MCP_COMMENT_MARKER=:claude:

# Optional: custom-field ids backing the curated agile fields surfaced by
# jira_get_issue (story points, sprint, epic link). Each id is auto-detected
# per instance at startup; set one of these ONLY if detection misses (the
# server logs a warning naming the omitted field). Find the id at
#   /rest/api/3/field  (search for the field's name).
# JIRA_FIELD_STORY_POINTS=customfield_10016
# JIRA_FIELD_SPRINT=customfield_10020
# JIRA_FIELD_EPIC_LINK=customfield_10014

# Optional: hard byte ceiling for jira_read_attachment. A file larger than this
# is refused BEFORE download — the response carries a note + the download URL
# rather than fetching pathological bytes. Defaults to 25 MB (26214400).
# JIRA_MCP_ATTACHMENT_MAX_BYTES=26214400

# Optional: jira_add_attachment upload guardrails. Uploads are scoped to these
# roots — a path resolving (after ../symlink) outside ALL of them is refused, so
# a prompt-injected path can't exfiltrate files like ~/.ssh/id_rsa. Path-delimiter-
# separated (":" on POSIX). Defaults cover only dirs whose contents the agent
# itself produces (the project cwd + the OS temp dirs). Dirs holding personal
# files (e.g. ~/Downloads) are a deliberate per-operator opt-in — a poisoned
# issue body naming a file there would otherwise upload it. Example opting in
# ~/Downloads for a browser-download flow:
# JIRA_ATTACHMENT_ROOT=/Users/me/code/project:/tmp:~/Downloads
# Upload size cap — a larger file is refused with a hint, not a raw 413. 25 MB default.
# JIRA_MCP_ATTACHMENT_UPLOAD_MAX_BYTES=26214400
